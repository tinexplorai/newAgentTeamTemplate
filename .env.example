# Copy this file to `.env` and fill only the values your project needs.
# `.env` is gitignored. Never commit secrets.
#
# Marker rules:
# - Use `[PLACEHOLDER]` when Team Lead should ask you once.
# - Use `N/A` when the responsible agent should choose a reasonable default.
# - Leave secret tokens empty until you need the related MCP/deploy step.

# --- Figma (Designer Agent, optional) ---
# Create a personal access token:
# https://www.figma.com/developers/api#access-tokens
# File URL comes from opening the Figma file and copying the browser URL.
FIGMA_API_KEY=
FIGMA_FILE_URL=N/A

# --- GitHub (DevOps Agent) ---
# Required for fully automatic push and CI setup after deployment approval.
# Token needs repo contents and workflow permissions for the target repository.
# Fine-grained token page:
# https://github.com/settings/personal-access-tokens
# Recommended permissions for the existing repo: Contents read/write, Workflows
# read/write, Actions read.
# Repo URL example: https://github.com/<owner>/<repo>.git
GITHUB_TOKEN=
GITHUB_REPO_URL=[PLACEHOLDER]
GITHUB_DEFAULT_BRANCH=main

# --- Vercel (DevOps Agent, web deploys only) ---
# Required for fully automatic Vercel deploys. By default, the Vercel project
# must already exist; project creation requires a separate explicit instruction.
# Create token:
# https://vercel.com/account/settings/tokens
# Team slug is in the team URL, for example https://vercel.com/<team-slug>.
# Project slug is in Project Settings -> General, or in the project URL.
# Runtime env vars must also exist in Vercel Project Settings -> Environment
# Variables, or DevOps must be able to set them by name during deploy.
VERCEL_TOKEN=
VERCEL_TEAM_SLUG=N/A
VERCEL_PROJECT_SLUG=N/A

# Optional smoke-test hints. Use N/A to let DEV/QA/DevOps choose a stable route.
WEB_SMOKE_TEST_PATH=N/A
API_HEALTHCHECK_PATH=N/A

# --- Project Runtime Secrets (only when the generated app needs them) ---
# Add third-party API keys here when the project spec, TechLead, DEV, or Flutter
# chooses an integration. Keep unused values empty or N/A.
#
# OpenAI API keys:
# https://platform.openai.com/api-keys
# OpenRouter API keys:
# https://openrouter.ai/settings/keys
#
# Agents must document required variable names in their handoff docs and DevOps
# must configure the same names in CI/Vercel without printing secret values.
# Examples:
OPENAI_API_KEY=N/A
OPENROUTER_API_KEY=N/A

# --- Supabase (TechLead/DEV/Flutter, only if project uses Supabase) ---
# MCP management token for schema inspection/migrations.
# Create access token:
# https://supabase.com/dashboard/account/tokens
# Project ref appears in the project URL:
# https://supabase.com/dashboard/project/<project-ref>
# Runtime API values are in Project Settings -> API.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=N/A

# Runtime keys used by generated apps.
SUPABASE_URL=N/A
SUPABASE_ANON_KEY=

# Server-only privileged key. Never expose this to frontend or mobile clients.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mobile (Flutter + DevOps, mobile projects only) ---
# iOS bundle ID and Apple Team ID come from Apple Developer account:
# https://developer.apple.com/account/resources/identifiers/list
# Android package is the applicationId/package name you want, for example
# com.example.app. Play Console distribution requires an existing app/account:
# https://play.google.com/console
BUNDLE_ID=N/A
APPLE_TEAM_ID=N/A
IOS_DISTRIBUTION_CHANNEL=TestFlight
ANDROID_PACKAGE=N/A
ANDROID_DISTRIBUTION_CHANNEL=N/A
